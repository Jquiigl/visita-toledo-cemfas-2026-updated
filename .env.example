# PAGES + SUPABASE (production). Runtime values belong in Cloudflare Pages settings.
# Local Pages preview reads .dev.vars; this file is documentation, not credentials.
# No frontend environment variables are required by this architecture.
# Supabase URL + publishable key are public-capable, but used only by the server here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# PRIVATE: generate 32 random bytes as 64 hexadecimal characters. Never commit.
SESSION_ENCRYPTION_KEY=
# PRIVATE JSON: map a chosen username to the real Supabase Auth email; default empty.
ADMIN_LOGIN_ALIASES={}

# LEGACY LOCAL BACKUP ONLY (Vinext/D1). Not used by Pages/Supabase.
# Never use VITE_, PUBLIC_ or NEXT_PUBLIC_ for secrets.
ADMIN_USERS=
DATA_SOURCE=mock
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
REGISTRATION_SHEET_ID=
EVALUATION_SHEET_ID=
REGISTRATION_RANGE=
EVALUATION_RANGE=
GOOGLE_COLUMN_MAPPING=
OPENAI_API_KEY=
OPENAI_MODEL=
# No AI key is required. Choose the provider before defining its vendor-specific secret.
