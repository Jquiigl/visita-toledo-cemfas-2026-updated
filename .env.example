# Documentation only. Server runtime secrets are set in .dev.vars locally / Sites in hosting.
# Never use VITE_ or NEXT_PUBLIC_ for secrets.
ADMIN_USERS=
DATA_SOURCE=mock
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
REGISTRATION_SHEET_ID=
EVALUATION_SHEET_ID=
REGISTRATION_RANGE=
EVALUATION_RANGE=
GOOGLE_COLUMN_MAPPING=
OPENAI_API_KEY=
OPENAI_MODEL=
# No AI key is required. Choose the provider before defining its vendor-specific secret.
